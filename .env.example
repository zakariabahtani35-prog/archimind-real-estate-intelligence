# Application
ENVIRONMENT=development
APP_NAME=ArchiMind AI ML Platform
APP_VERSION=2.4.0-ml-skeleton
APP_URL=http://localhost:5173
DEBUG=true
LOG_LEVEL=info

# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_APP_NAME=ArchiMind AI
VITE_API_URL=http://localhost:8000
VITE_USER_AVATAR_URL=https://api.dicebear.com/7.x/avataaars/svg?seed=Sarah
VITE_ENABLE_MOCKS=false

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=avito_db
DB_USER=postgres
DB_PASSWORD=1234

# Security
SECRET_KEY=change_this_secret
JWT_SECRET=change_this_jwt_secret

# Integrations
GEMINI_API_KEY=

# Backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PRICE_MODEL_PATH=backend/app/artifacts/price_model.pkl
CLASSIFICATION_MODEL_PATH=backend/app/artifacts/classification_model.pkl
UPLOAD_DIR=backend/app/uploads
DATABASE_URL=postgresql+psycopg2://postgres:1234@127.0.0.1:5432/avito_db
METRICS_PATH=backend/app/artifacts/metrics.json
REGRESSION_REPORT_PATH=backend/app/artifacts/regression_report.json
CLASSIFICATION_REPORT_PATH=backend/app/artifacts/classification_report.json
ERROR_ANALYSIS_PATH=backend/app/artifacts/error_analysis.json
FEATURE_IMPORTANCE_PATH=backend/app/artifacts/feature_importance.json
